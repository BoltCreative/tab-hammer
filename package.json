{
  "name": "tab-hammer",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A Chrome extension for seeing and organizing every open window and tab as an outline, in its own window. A spiritual successor to Tabs Outliner, built to fix its annoyances.",
  "workspaces": [
    "packages/protocol",
    "packages/extension",
    "packages/mcp"
  ],
  "scripts": {
    "dev": "npm run dev -w @tab-hammer/extension",
    "build": "npm run build -w @tab-hammer/extension",
    "build:e2e": "npm run build:e2e -w @tab-hammer/extension",
    "build:store": "npm run build:store -w @tab-hammer/extension",
    "release": "node scripts/release.ts",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @tab-hammer/extension --",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gate": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run build:e2e && npm run test:e2e",
    "install-mcp": "npm run install-host -w @tab-hammer/mcp",
    "uninstall-mcp": "npm run uninstall-host -w @tab-hammer/mcp",
    "make:chrome-launcher": "npm run make:chrome-launcher -w @tab-hammer/extension"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.0",
    "@types/node": "^26.6.3"
  }
}
