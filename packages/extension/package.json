{
  "name": "@tab-hammer/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "TAB_HAMMER_NO_OAUTH=1 vite build --outDir dist-e2e --emptyOutDir",
    "build:store": "TAB_HAMMER_STORE=1 vite build --outDir dist-store --emptyOutDir && node scripts/pack-store.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "make:chrome-launcher": "scripts/make-chrome-launcher.sh",
    "render-icons": "node scripts/render-icons.ts"
  },
  "dependencies": {
    "@tab-hammer/protocol": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@playwright/test": "^1.63.0",
    "@types/chrome": "^0.3.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "rolldown": "~1.2.11",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
